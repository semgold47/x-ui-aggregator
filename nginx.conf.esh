worker_processes auto;
events {
    worker_connections 1024;
}

http {
    proxy_buffering off;
    underscores_in_headers on;

    server {
        listen ${SITE_PORT};
        server_name ${SITE_HOST};

        location ~ ^/${SUB}/([^/]+)/?$ {
            set $sub_id $1;
            content_by_lua_file /etc/nginx/lua/config_fetcher.lua;
        }
    }
}
