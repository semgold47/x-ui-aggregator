# Домен, на котором будет висеть прокси
SITE_HOST=sub.example.com

# Порт (обычно 443 для HTTPS, но можно и 80)
SITE_PORT=443

# Список серверов 3x-ui через пробел (ВАЖНО: порядок влияет на total и expire)
# Формат: https://domain1.com/sub/ https://domain2.com/sub/ https://domain3.com/sub/
SERVERS="https://server1.com/abc123/ https://server2.com/def456/ https://server3.com/ghi789/"

# Путь к подписке (будет доступно по адресу https://ваш-домен/sub/ID_клиента)
SUB=sub

# Режим TLS: off — без HTTPS, on — с HTTPS (требуются сертификаты в ./ssl)
TLS_MODE=off
